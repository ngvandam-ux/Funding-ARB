# Funding-Arb — environment template. Commit THIS file (placeholders only).
# Copy to .env.local and fill in real values. .env.local is gitignored.
# CLAUDE.md hard rule #2: never commit real keys.

# --- Frontend (Vite, shipped to the browser) ---
# The anon key is RLS-protected and safe for the browser. The URL is public.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Edge Functions ONLY (never expose to the browser; no VITE_ prefix) ---
# Used for local `supabase functions serve`. In production this lives in
# Supabase project secrets, not in this file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- v2 only — DO NOT set or read in v1 (hard rule: reading these in v1 is a bug) ---
# HYPERLIQUID_WALLET_ADDRESS=
# HYPERLIQUID_PRIVATE_KEY=
